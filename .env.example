# ==========================================
# CHAT DE DIOS - CONFIGURACIÓN DE MODELOS IA
# ==========================================

# Puedes usar cualquiera de estas opciones (o ambas):

# 1. Google Gemini (Recomendado - Gratuito y Rápido en Google AI Studio: https://aistudio.google.com/)
GOOGLE_GENERATIVE_AI_API_KEY=tu_gemini_api_key_aqui

# 2. OpenAI (GPT-4o, GPT-4o-mini: https://platform.openai.com/)
OPENAI_API_KEY=tu_openai_api_key_aqui

# 3. Groq (Llama 3.3 70B Ultra Rápido y Gratis: https://console.groq.com/)
# Se puede usar a través del endpoint compatible de OpenAI configurando GROQ_API_KEY
GROQ_API_KEY=tu_groq_api_key_aqui

# Modelo por defecto (opcional: 'gemini-1.5-flash', 'gemini-2.0-flash', 'gpt-4o-mini', 'llama-3.3-70b-versatile')
DEFAULT_AI_MODEL=gemini-2.0-flash
